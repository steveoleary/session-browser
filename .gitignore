# macOS
.DS_Store
._*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Local tooling state

# Demo corpus generator output (python -m session_browser.demo)
demo-home/

# Per-clone agent hooks, paired with the untracked settings.local.json that
# wires them. Tracked hooks belong in .claude/hooks/ under their own names.
.claude/hooks/*.local.sh
# The whole tracker is deliberately untracked here. Its issues carry working
# notes that are not part of the published project, and the tracker syncs across
# machines through its own data remote rather than through this repository —
# so nothing is lost by keeping .tracker/ out of it.
.tracker/
.tracker-data/
*.db
.tracker-credential-key
# Workspace gate lock. the tool writes gate files beside the root they guard, so the
# gate for .tracker/ itself lands here, out of reach of .tracker/.gitignore.
.tracker.gate.lock
/explainers
